# Environment variable template.
# Copy this file to .env and fill in any values that need to differ from defaults.
# Never commit .env to Git.

# Prometheus URL reachable from host (adjust port if port-forward changes)
PROMETHEUS_URL=http://localhost:9090

# Grafana URL
GRAFANA_URL=http://localhost:3000

# Kubernetes namespace for the benchmark application
APP_NAMESPACE=autoscaler-app

# Monitoring namespace
MONITORING_NAMESPACE=monitoring

# Minikube driver (docker recommended on Mac)
MINIKUBE_DRIVER=docker

# Python interpreter to use when creating the virtual environment
PYTHON_BIN=python3.10
